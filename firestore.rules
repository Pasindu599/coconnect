rules_version = '2';

// See .claude/docs/specs/data-model.md for the collection-by-collection design
// this implements, and .claude/docs/specs/auth.md for why authorization reads
// request.auth.token.memberships (a custom claim) rather than doing a get()
// on the caller's own user doc on every rule evaluation.
//
// Field names below match the EXISTING types in src/types/index.ts
// (Estate, LabourJob, Bid, Worker, Award, ...) on purpose, "supervisor_id"
// and "estate_id" included — those types are read by ~100+ call sites in
// src/components/** (Session 2's files), so this spec does not rename them
// even for non-coconut categories. See DECISIONS.md ADR-007.
//
// Every field access below is guarded with `'field' in data` first. A plain
// `data.field == x` throws "Property field is undefined" for a collection
// `list`/`onSnapshot` query (not a single `get()`) as soon as ANY candidate
// document in the collection lacks that field — found live via
// tests/integration/, which exercises onSnapshot the way store.startSync()
// actually does; tests/rules/ alone (mostly single-document get/set) never
// triggered it. See DECISIONS.md ADR-008.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 'admin' in request.auth.token && request.auth.token.admin == true;
    }

    function hasMembership(category, role) {
      return isSignedIn()
        && 'memberships' in request.auth.token
        && request.auth.token.memberships.hasAny([{'category': category, 'role': role}]);
    }

    // Capabilities mirror src/types/category.ts (CONTRACTS C1). Duplicated
    // here deliberately: Functions/rules never import frontend config.
    function isPoster(category) {
      return hasMembership(category, 'owner') || hasMembership(category, 'client');
    }

    function isBidder(category) {
      return hasMembership(category, 'broker')
        || hasMembership(category, 'contractor')
        || hasMembership(category, 'subcontractor');
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // data[field] == value, but false (not an error) when a candidate
    // document in a list/query simply doesn't have `field` at all.
    function fieldIs(data, field, value) {
      return (field in data) && data[field] == value;
    }

    function fieldIn(data, field, values) {
      return (field in data) && data[field] in values;
    }

    // ---- users ----
    match /users/{uid} {
      // All-or-nothing at the document level today (no field-level read
      // split), so reads are scoped to the owner and admins rather than any
      // authenticated user, since the doc carries NIC numbers and phone.
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.memberships == []
        && !('trust_score' in request.resource.data);

      // A user may update their own doc, but never memberships, nic_status
      // or trust_score client-side — those move only through Functions.
      allow update: if isSignedIn() && request.auth.uid == uid
        && unchanged('memberships')
        && unchanged('nic_status')
        && unchanged('trust_score');

      allow delete: if false;
    }

    // ---- estates (site label is "Estate" or "Site" per category, display
    // only — src/config/categories.ts; the collection/field name stays
    // "estates"/"estate_id" for every category, see ADR-007) ----
    match /estates/{estateId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.owner_id == request.auth.uid
        && isPoster(request.resource.data.category);

      allow update, delete: if isSignedIn() && fieldIs(resource.data, 'owner_id', request.auth.uid);
    }

    // ---- jobs ----
    match /jobs/{jobId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.owner_id == request.auth.uid
        && isPoster(request.resource.data.category)
        && request.resource.data.status in ['DRAFT', 'OPEN'];

      // The owner may edit while still DRAFT/OPEN, and may only move between
      // DRAFT, OPEN and CANCELLED. Every status past that (AWARDED_* onward)
      // is written by Functions, which use the Admin SDK and bypass rules.
      allow update: if isSignedIn()
        && fieldIs(resource.data, 'owner_id', request.auth.uid)
        && unchanged('owner_id')
        && fieldIn(resource.data, 'status', ['DRAFT', 'OPEN'])
        && request.resource.data.status in ['DRAFT', 'OPEN', 'CANCELLED'];

      allow delete: if false;
    }

    // ---- bids ----
    match /bids/{bidId} {
      // Sealed-bid: only the bidder and the job's owner can read a bid.
      // owner_id is denormalized onto the bid at submission time (not a
      // cross-document get()) specifically so this stays a plain field
      // check — see ADR-008/009 on why a list/onSnapshot query needs that.
      allow read: if isSignedIn()
        && (fieldIs(resource.data, 'supervisor_id', request.auth.uid)
            || fieldIs(resource.data, 'owner_id', request.auth.uid));

      allow create: if isSignedIn()
        && request.resource.data.supervisor_id == request.auth.uid
        && isBidder(request.resource.data.category)
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.job_id)).data.status == 'OPEN';

      // Two distinct kinds of update, both narrow:
      //  - the bidder edits their own still-pending bid
      //  - the job owner accepts/rejects (status only), while pending
      // Awarding (which also touches jobs + awards atomically) goes through
      // the awardBid Function/transaction instead of relying on this alone.
      allow update: if isSignedIn() && (
        (fieldIs(resource.data, 'supervisor_id', request.auth.uid)
          && fieldIs(resource.data, 'status', 'pending')
          && unchanged('supervisor_id')
          && unchanged('job_id'))
        || (
          fieldIs(resource.data, 'owner_id', request.auth.uid)
          && fieldIs(resource.data, 'status', 'pending')
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        )
      );

      allow delete: if false;
    }

    // ---- workers ----
    match /workers/{workerId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.supervisor_id == request.auth.uid
        && isBidder(request.resource.data.category);

      // rating and jobs_completed are derived server-side; never client-writable.
      allow update: if isSignedIn()
        && fieldIs(resource.data, 'supervisor_id', request.auth.uid)
        && unchanged('supervisor_id')
        && unchanged('rating')
        && unchanged('jobs_completed');

      allow delete: if false;
    }

    // ---- Functions-only collections ----
    match /awards/{awardId} {
      // owner_id is denormalized at award-creation time (functions/src/jobs/awardBid.ts) — see the bids comment above for why.
      allow read: if isSignedIn() && (
        isAdmin()
        || fieldIs(resource.data, 'supervisor_id', request.auth.uid)
        || fieldIs(resource.data, 'owner_id', request.auth.uid)
      );
      allow write: if false;
    }

    // owner_id/supervisor_id are denormalized onto payments and ledger
    // entries when a Function creates them (S1-09/S1-10), same reason as
    // bids/awards above — a list/onSnapshot query needs a plain field
    // check, not a cross-document get() (ADR-008/009).
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || fieldIs(resource.data, 'supervisor_id', request.auth.uid)
        || fieldIs(resource.data, 'owner_id', request.auth.uid)
      );
      allow write: if false;
    }

    match /ledger/{entryId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || fieldIs(resource.data, 'supervisor_id', request.auth.uid)
        || fieldIs(resource.data, 'owner_id', request.auth.uid)
      );
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    // ---- attendance ----
    // Denormalized owner_id/supervisor_id (same pattern as jobs' owner_name)
    // keep these rules a single field access away instead of a query rules can't do.
    match /attendance_days/{dayId} {
      allow read: if isSignedIn() && (
        fieldIs(resource.data, 'owner_id', request.auth.uid) || fieldIs(resource.data, 'supervisor_id', request.auth.uid) || isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.owner_id == request.auth.uid || request.resource.data.supervisor_id == request.auth.uid
      );
      allow update: if isSignedIn() && !fieldIs(resource.data, 'status', 'reconciled') && (
        fieldIs(resource.data, 'owner_id', request.auth.uid) || fieldIs(resource.data, 'supervisor_id', request.auth.uid)
      );
      allow delete: if false;
    }

    match /attendance_entries/{entryId} {
      allow read: if isSignedIn() && (
        fieldIs(resource.data, 'owner_id', request.auth.uid) || fieldIs(resource.data, 'supervisor_id', request.auth.uid) || isAdmin()
      );
      // Each party records only their own side.
      allow create: if isSignedIn()
        && request.resource.data.recorded_by == request.auth.uid
        && ((request.resource.data.party == 'owner' && request.resource.data.owner_id == request.auth.uid)
            || (request.resource.data.party == 'supervisor' && request.resource.data.supervisor_id == request.auth.uid));
      allow update, delete: if false;
    }

    // ---- completions ----
    match /completions/{completionId} {
      // submitted_by (an existing Completion field) already identifies the
      // supervisor side; no need for a parallel supervisor_id here.
      allow read: if isSignedIn() && (
        fieldIs(resource.data, 'owner_id', request.auth.uid) || fieldIs(resource.data, 'submitted_by', request.auth.uid) || isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.submitted_by == request.auth.uid
        && request.resource.data.status == 'pending';
      // Confirmation checks a hashed PIN server-side (confirmCompletion Function).
      allow update, delete: if false;
    }

    // ---- ratings ----
    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.from_user_id == request.auth.uid;
      // No reliable one-per-job uniqueness without a query; documented gap
      // in .claude/docs/specs/payments.md and KNOWN_ISSUES.
      allow update, delete: if false;
    }

    // ---- disputes ----
    match /disputes/{disputeId} {
      allow read: if isSignedIn() && (
        fieldIs(resource.data, 'owner_id', request.auth.uid) || fieldIs(resource.data, 'supervisor_id', request.auth.uid) || isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.opened_by == request.auth.uid
        && (request.resource.data.owner_id == request.auth.uid || request.resource.data.supervisor_id == request.auth.uid)
        && request.resource.data.status == 'open';
      // resolveDispute (admin, via a Function) writes the resolution.
      allow update, delete: if false;
    }

    // ---- NIC submissions ----
    match /nic_submissions/{subId} {
      allow read: if isSignedIn() && (fieldIs(resource.data, 'user_id', request.auth.uid) || isAdmin());
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Deny anything not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
