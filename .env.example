# Copy this file to `.env.local` and fill in real values.
# `.env*` is gitignored except for this file. NEVER commit a real key here.

# APP_URL: The deployed site URL (Vercel). Used for self-referential links and
# OAuth callbacks.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key (browser key).
#
# Anything prefixed with VITE_ is inlined into the JS bundle and is therefore
# PUBLIC. A Maps browser key is only safe because of the restrictions set on it
# in Google Cloud Console, not because it is hidden. Before using a key here:
#   1. Application restriction: HTTP referrers.
#      Allowed referrers (one key per environment, not one key for all):
#        - http://localhost:3000/*            (dev key)
#        - https://<staging-domain>/*         (staging key)
#        - https://<production-domain>/*      (production key)
#   2. API restriction: Maps JavaScript API only (plus Places/Geocoding if used).
#   3. Set a daily quota cap and a billing budget alert on the project.
# See .claude/docs/runbooks/google-maps-key.md for the full rotation runbook.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_BROWSER_KEY"

# --- Supabase (ADR-014) -----------------------------------------------------
# From the dashboard: Project Settings > API. Both are public by design: what
# protects the data is Row Level Security, not these values. Leave them unset
# to run the in-browser demo (no backend).
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# VITE_AUTH_MODE: "supabase" for real phone/staff sign-in and live data sync.
# Unset = demo sign-in (code 123456), all data stays in the browser.
VITE_AUTH_MODE=""

# --- Server-side only: scripts and tests, NEVER prefixed with VITE_ -----------
# Used by `npm run db:push`, `npm run seed` and `npm run test:db`. The
# service_role key bypasses RLS: keep it out of the browser and out of git.
# SUPABASE_DB_URL is the "Session pooler" connection string (Project Settings >
# Database > Connect), with the database password filled in.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_DB_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
