rules_version = '2';

// See .claude/docs/specs/data-model.md (nic_submissions) — NIC images are
// Storage paths, not localStorage data URLs (closes KNOWN_ISSUES #8).
service firebase.storage {
  match /b/{bucket}/o {
    match /nic/{uid}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || ('admin' in request.auth.token && request.auth.token.admin == true));

      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
