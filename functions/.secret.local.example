# Copy to `.secret.local` (gitignored) for local Functions-emulator
# development. The emulator reads defineSecret() values from this file
# instead of Secret Manager — see functions/src/payments/createPayment.ts.
#
# For the real sandbox merchant secret once 1C-4 delivers it, use
# `firebase functions:secrets:set PAYHERE_MERCHANT_SECRET` for deployed
# environments — never put the real value in a file here.
PAYHERE_MERCHANT_SECRET=local-dev-placeholder-secret
